{
  "name": "@apify/hiring-database",
  "version": "0.1.0",
  "description": "A minimalistic, MongoDB-like document database for TypeScript.",
  "license": "MIT",
  "author": "Apify",
  "keywords": [
    "database",
    "document-database",
    "nosql",
    "mongodb",
    "collection",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apify/hiring-in-memory-document-database.git"
  },
  "homepage": "https://github.com/apify/hiring-in-memory-document-database#readme",
  "bugs": {
    "url": "https://github.com/apify/hiring-in-memory-document-database/issues"
  },
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:markers",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:markers": "node scripts/write-package-markers.mjs",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
